// Dépôt Malin — schéma de données (Phase 1)
// Modélise la section 10 de la base de connaissance.
// Base : PostgreSQL + PostGIS (hébergée sur Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  PARTICULIER
  PRO
}

enum ListingStatus {
  BROUILLON
  EN_ATTENTE_MODERATION
  EN_LIGNE
  SUSPENDU
}

enum DeliveryMode {
  P2P
  POINT_RELAIS
  LIVRAISON // le propriétaire apporte et vient rechercher l'objet (voir src/lib/livraison.ts)
}

enum BookingStatus {
  RESERVEE
  EN_COURS
  RETOURNEE
  CLOTUREE
  ANNULEE
  LITIGE
}

enum ConditionReportType {
  ENTREE
  SORTIE
}

enum ConditionReportAuthor {
  PROPRIETAIRE
  LOCATAIRE
  STAFF
}

enum RelayStockStatus {
  DEPOSE
  RETIRE
  RETOURNE
}

// Service payant « promotion sur les réseaux sociaux » (src/lib/promotionReseaux.ts).
enum FormulePromotion {
  PUBLICATION
  PUBLICITE
}

enum StatutPromotion {
  A_FAIRE
  PUBLIEE
}

enum DisputeStatus {
  OUVERT
  EN_COURS
  RESOLU
  REJETE
}

// ---------------------------------------------------------------------------
// Utilisateur
// ---------------------------------------------------------------------------

model User {
  id                          String     @id @default(uuid())
  // Lié à l'utilisateur Supabase Auth (auth.users.id) — pas de mot de passe stocké ici.
  supabaseAuthId              String     @unique
  email                       String     @unique
  nom                         String?
  telephone                   String?
  statut                      UserStatus @default(PARTICULIER)
  siret                       String? // obligatoire si statut = PRO
  numeroTva                   String?
  nomEntreprise               String?
  // Abonnement Pro (voir src/lib/abonnementPro.ts), tenu à jour par le webhook Stripe.
  stripeCustomerId            String?    @unique
  stripeSubscriptionId        String?
  proActifJusquau             DateTime? // fin de la période payée ; avantages Pro jusqu'à cette date
  proResiliationPrevue        Boolean    @default(false)
  derniereMiseEnAvantOfferte  DateTime?
  // Badge « Identité vérifiée » (voir src/lib/verificationIdentite.ts). On ne
  // stocke aucune donnée de la pièce d'identité, seulement l'état.
  identiteVerifieeLe          DateTime?
  verificationIdentitePayee   Boolean    @default(false)
  dernierPaiementVerification String?
  stripeVerificationSessionId String?
  statutVerificationIdentite  String? // statut Stripe : processing, requires_input…
  noteMoyenne                 Float?
  stripeAccountId             String? // compte Stripe Connect (Express)
  stripeOnboardingDone        Boolean    @default(false)
  // Rôle interne (section 3.2) : donne accès au back-office (/admin). Aucune
  // UI d'auto-promotion — à définir manuellement en base (voir README).
  estAdmin                    Boolean    @default(false)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  listings               Listing[]                 @relation("ProprietaireListings")
  bookingsAsLocataire    Booking[]                 @relation("LocataireBookings")
  bookingsAsProprietaire Booking[]                 @relation("ProprietaireBookings")
  conversations          ConversationParticipant[]
  promotionsReseaux      PromotionReseaux[]
  messagesSent           Message[]
  reviewsWritten         Review[]                  @relation("ReviewAuteur")
  reviewsReceived        Review[]                  @relation("ReviewCible")
  conditionReports       ConditionReport[]
  disputesOuverts        Dispute[]                 @relation("DisputeOuvrePar")

  @@index([statut])
}

// ---------------------------------------------------------------------------
// Catégories
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  nom         String
  slug        String   @unique
  description String?
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())

  listings Listing[]
}

// ---------------------------------------------------------------------------
// Annonce
// ---------------------------------------------------------------------------

model Listing {
  id             String   @id @default(uuid())
  slug           String   @unique
  proprietaireId String
  proprietaire   User     @relation("ProprietaireListings", fields: [proprietaireId], references: [id])
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])

  titre       String
  description String
  photos      String[] // URLs vers le storage S3-compatible / Supabase Storage

  // Tarifs par palier (4 optionnels — voir section 9.1)
  prixDemiJournee Decimal? @db.Decimal(10, 2)
  prixJournee     Decimal? @db.Decimal(10, 2)
  prixSemaine     Decimal? @db.Decimal(10, 2)
  prixMois        Decimal? @db.Decimal(10, 2)

  // Caution (section 9.2)
  prixNeufEstime      Decimal? @db.Decimal(10, 2)
  ageMateriel         String? // ex: "< 1 an", "1-3 ans", "3-5 ans", "> 5 ans"
  montantCaution      Decimal? @db.Decimal(10, 2)
  cautionEstimeeParIA Boolean  @default(false)
  attestationHonneur  Boolean  @default(false)

  modesRemise         DeliveryMode[]
  // Livraison par le propriétaire (mode LIVRAISON) : prix aller-retour et
  // distance maximale autour de l'adresse de l'annonce.
  prixLivraison       Decimal?       @db.Decimal(10, 2)
  distanceLivraisonKm Int?

  // Géolocalisation
  latitude   Float?
  longitude  Float?
  ville      String?
  codePostal String?
  adresse    String?

  statut ListingStatus @default(BROUILLON)

  // Durée de mise en ligne (voir src/lib/dureeAnnonce.ts) : visible jusqu'à
  // cette date ; null = sans limite (membres Pro, annonces non validées).
  enLigneJusquau               DateTime?
  // Dernier paiement de prolongation traité (évite de prolonger deux fois
  // si Stripe renvoie le même événement).
  derniereProlongationPaiement String?
  // Service payant « annonce mise en avant » (voir src/lib/miseEnAvant.ts).
  misEnAvantJusquau            DateTime?
  dernierPaiementMiseEnAvant   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilities    Availability[]
  bookings          Booking[]
  promotionsReseaux PromotionReseaux[]

  @@index([categoryId])
  @@index([ville])
  @@index([statut])
}

// ---------------------------------------------------------------------------
// Disponibilité
// ---------------------------------------------------------------------------

model Availability {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dateDebut DateTime
  dateFin   DateTime
  createdAt DateTime @default(now())

  @@index([listingId])
}

// ---------------------------------------------------------------------------
// Réservation / location
// ---------------------------------------------------------------------------

model Booking {
  id             String  @id @default(uuid())
  listingId      String
  listing        Listing @relation(fields: [listingId], references: [id])
  locataireId    String
  locataire      User    @relation("LocataireBookings", fields: [locataireId], references: [id])
  proprietaireId String
  proprietaire   User    @relation("ProprietaireBookings", fields: [proprietaireId], references: [id])

  dateDebut              DateTime
  dateFin                DateTime
  palierApplique         String // "demi_journee" | "journee" | "semaine" | "mois" | "combinaison"
  montantLocation        Decimal      @db.Decimal(10, 2)
  fraisServiceLocataire  Decimal      @db.Decimal(10, 2) // TAUX_FRAIS_LOCATAIRE
  commissionProprietaire Decimal      @db.Decimal(10, 2) // TAUX_COMMISSION_PROPRIETAIRE
  fraisPointRelais       Decimal?     @db.Decimal(10, 2) // à la charge du locataire si mode = POINT_RELAIS
  // Commerçant relais choisi par le locataire (mode POINT_RELAIS).
  relayPointId           String?
  relayPoint             RelayPoint?  @relation(fields: [relayPointId], references: [id])
  // Livraison par le propriétaire (mode LIVRAISON) : payée par le locataire,
  // reversée au propriétaire moins la commission Dépôt Malin.
  fraisLivraison         Decimal?     @db.Decimal(10, 2)
  commissionLivraison    Decimal?     @db.Decimal(10, 2)
  adresseLivraison       String?
  montantCaution         Decimal      @db.Decimal(10, 2)
  modeRemise             DeliveryMode

  statut BookingStatus @default(RESERVEE)

  // Contrat de location (voir src/components/ContratLocation.tsx) : date et
  // heure d'acceptation en ligne par chaque partie, valant signature.
  contratAccepteLocataireLe    DateTime?
  contratAccepteProprietaireLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction      Transaction?
  conditionReports ConditionReport[]
  conversation     Conversation?
  reviews          Review[]
  dispute          Dispute?
  relayStock       RelayStock?

  @@index([listingId])
  @@index([locataireId])
  @@index([proprietaireId])
  @@index([statut])
}

// ---------------------------------------------------------------------------
// Transaction (Stripe)
// ---------------------------------------------------------------------------

model Transaction {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  stripePaymentIntentId String?
  stripeSetupIntentId   String? // caution : carte enregistrée, débit off-session si dommage
  stripeApplicationFee  Decimal? @db.Decimal(10, 2)
  stripeTransferId      String? // reversement au propriétaire

  statut       String // libre, à préciser en Phase 3 (ex: "en_attente"/"paye"/"rembourse"/...)
  montantTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// État des lieux
// ---------------------------------------------------------------------------

model ConditionReport {
  id         String                @id @default(uuid())
  bookingId  String
  booking    Booking               @relation(fields: [bookingId], references: [id])
  type       ConditionReportType
  auteurType ConditionReportAuthor
  auteurId   String?
  auteur     User?                 @relation(fields: [auteurId], references: [id])
  photos     String[]
  notes      String?
  createdAt  DateTime              @default(now())

  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Messagerie
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(uuid())
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteurId   String
  expediteur     User         @relation(fields: [expediteurId], references: [id])
  contenu        String
  lu             Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Avis
// ---------------------------------------------------------------------------

model Review {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  auteurId    String
  auteur      User     @relation("ReviewAuteur", fields: [auteurId], references: [id])
  cibleId     String
  cible       User     @relation("ReviewCible", fields: [cibleId], references: [id])
  note        Int // 1 à 5
  commentaire String?
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([cibleId])
}

// ---------------------------------------------------------------------------
// Point relais (1 site en Haute-Marne pour la V1)
// ---------------------------------------------------------------------------

model RelayPoint {
  id         String   @id @default(uuid())
  nom        String
  adresse    String
  ville      String
  codePostal String
  latitude   Float?
  longitude  Float?
  horaires   String?
  telephone  String?
  // Commerçant partenaire proposé aux locataires (false = retiré de la liste).
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())

  stocks   RelayStock[]
  bookings Booking[]
}

model RelayStock {
  id           String           @id @default(uuid())
  relayPointId String
  relayPoint   RelayPoint       @relation(fields: [relayPointId], references: [id])
  bookingId    String           @unique
  booking      Booking          @relation(fields: [bookingId], references: [id])
  statut       RelayStockStatus @default(DEPOSE)
  dateDepot    DateTime?
  dateRetrait  DateTime?
  dateRetour   DateTime?

  @@index([relayPointId])
}

// ---------------------------------------------------------------------------
// Litige (V1 = email)
// ---------------------------------------------------------------------------

model Dispute {
  id                   String        @id @default(uuid())
  bookingId            String        @unique
  booking              Booking       @relation(fields: [bookingId], references: [id])
  ouvertParId          String
  ouvertPar            User          @relation("DisputeOuvrePar", fields: [ouvertParId], references: [id])
  motif                String
  statut               DisputeStatus @default(OUVERT)
  decision             String?
  montantCautionRetenu Decimal?      @db.Decimal(10, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

// Promotion d'une annonce sur les pages Facebook et Instagram de Dépôt Malin,
// payée par le propriétaire puis publiée à la main par un administrateur.
model PromotionReseaux {
  id                    String           @id @default(cuid())
  listingId             String
  listing               Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  formule               FormulePromotion
  montant               Decimal          @db.Decimal(10, 2)
  // Un paiement Stripe ne crée qu'une seule demande, même si l'événement est renvoyé.
  stripePaymentIntentId String           @unique
  statut                StatutPromotion  @default(A_FAIRE)
  lienPublication       String?
  publieeLe             DateTime?
  createdAt             DateTime         @default(now())

  @@index([statut])
  @@index([listingId])
}

// Message envoyé depuis le formulaire de la page Contact (src/lib/contact.ts),
// lu par l'équipe dans /admin/messages.
model MessageContact {
  id        String   @id @default(cuid())
  nom       String
  email     String
  sujet     String
  message   String
  traite    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([traite])
}
